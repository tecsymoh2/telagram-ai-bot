# ===== REQUIRED (only these 3) =====
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
DATABASE_URL=

# ===== OPTIONAL =====
ADMIN_IDS=            # your Telegram user id(s), comma separated
TELEGRAM_WEBHOOK_SECRET=   # auto-generated if empty
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
ALLOWED_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b
SYSTEM_PROMPT=You are a helpful, friendly assistant inside Telegram. Keep answers clear and concise.
DAILY_LIMIT=50
RATE_LIMIT_PER_MIN=8
HISTORY_LIMIT=20

# ===== NEW (all optional) =====
# TECHLAND_API_KEY can also be set from Telegram with /setkey (stored in the database)
TECHLAND_API_KEY=
GROQ_SEARCH_MODEL=groq/compound-mini
IMAGE_API_URL=https://image.pollinations.ai/prompt/{prompt}?width=1024&height=1024&nologo=true
PREMIUM_DAILY_LIMIT=500
FREE_IMAGE_LIMIT=2
PREMIUM_IMAGE_LIMIT=30
FREE_SEARCH_LIMIT=5
PREMIUM_SEARCH_LIMIT=50
FREE_DOC_LIMIT=2
PREMIUM_DOC_LIMIT=20
REFERRAL_DAYS=3
REFERRAL_INVITEE_DAYS=1
MAX_REWARDED_REFERRALS=20
